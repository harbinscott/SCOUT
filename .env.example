# Loopback port used by the host's Nginx
SC_HTTP_PORT=3001

# Application path and mode
BASE_PATH=/scout
USE_MOCK_DATA=true

# Browser credential (intentionally delivered to browsers; restrict by referrer and API)
GOOGLE_MAPS_BROWSER_KEY=

# Cost and abuse controls
TRAFFIC_CACHE_MINUTES=15
STATIC_CACHE_DAYS=7
RATE_LIMIT_PER_MINUTE=30
MAX_EXTERNAL_CALLS_PER_HOUR=60
MAX_EXTERNAL_CALLS_PER_DAY=200
MAX_EXTERNAL_CALLS_PER_MONTH=8000

# Live server-key file (only used with docker-compose.live.yml)
SC_ISOCHRONES_KEY_FILE=./secrets/isochrones_key.txt
